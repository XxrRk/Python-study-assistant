   "source": [
    "# pathlib 路径操作\n",
    "\n",
    "pathlib 用 Path 对象表示文件路径，比直接拼接字符串更清晰。\n",
    "`Path(\"data\") / \"file.txt\"` 可以拼接路径。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SHOULD_NOT_APPEAR: notebook output must be ignored\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "p = Path(\"data\") / \"file.txt\"\n",
    "print(p)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "`Path(\"data/file.txt\").parent` 返回父目录 `Path(\"data\")`。\n"
   ]
  }
 ],
