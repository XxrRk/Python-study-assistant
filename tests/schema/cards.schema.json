{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/python-study-assistant/cards.schema.json",
  "title": "Python Study Assistant knowledge cards",
  "type": "object",
  "required": ["source", "cards"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "粘贴文本说明、文件名或来源列表"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "title", "knowledge", "example", "question"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": ["library", "knowledge"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "knowledge": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "library": {
            "type": "object",
            "required": ["name", "package", "kind"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "package": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["stdlib", "third-party"]
              }
            }
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "library"
                }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["library"]
            },
            "else": {
              "not": {
                "required": ["library"]
              }
            }
          }
        ]
      }
    }
  }
}
