{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/python-study-assistant/collection.schema.json",
  "title": "Python Study Assistant Collection v1.0",
  "type": "object",
  "required": ["schema_version", "collection_id", "decks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/deck"
      }
    }
  },
  "$defs": {
    "deck": {
      "type": "object",
      "required": ["deck_id", "path"],
      "additionalProperties": false,
      "properties": {
        "deck_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["core", "reference", "archive"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
