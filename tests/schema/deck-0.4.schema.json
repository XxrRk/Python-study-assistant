{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/python-study-assistant/deck-0.4.schema.json",
  "title": "Python Study Assistant Deck v0.4.0",
  "type": "object",
  "required": ["schema_version", "deck_id", "sources", "cards"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "deck_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "kind", "ref", "added_at"],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src-[0-9]{6}$"
        },
        "kind": {
          "enum": ["paste", "markdown", "txt", "py", "ipynb", "html", "directory"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "added_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "library": {
      "type": "object",
      "required": ["name", "package", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["stdlib", "third-party"]
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["card_id", "type", "title", "knowledge", "example", "question", "source_id", "source_ref", "created_at"],
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^c-[0-9]{6}$"
        },
        "type": {
          "enum": ["library", "knowledge"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "knowledge": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "library": {
          "$ref": "#/$defs/library"
        },
        "source_id": {
          "type": "string",
          "pattern": "^src-[0-9]{6}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "archived": {
          "type": "boolean"
        },
        "origin_deck_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "library"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["library"]
          },
          "else": {
            "not": {
              "required": ["library"]
            }
          }
        }
      ]
    }
  }
}
